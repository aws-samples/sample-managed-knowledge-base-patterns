{
  "compilerOptions": {
    "target": "ES2023",
    // This package has no "type": "module", so nodenext resolves it as CommonJS. The root
    // script runs src/cli.ts through tsx, so nothing is emitted.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.mts"],
  "exclude": ["node_modules"]
}
