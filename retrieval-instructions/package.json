{
  "name": "retrieval-instructions",
  "version": "0.1.0",
  "private": true,
  "description": "Per-tenant retrieval instructions for Amazon Bedrock Managed Knowledge Base",
  "license": "MIT-0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "synth": "npm run synth --workspace @retrieval-instructions/infra --",
    "synth:example": "npm run synth:example --workspace @retrieval-instructions/infra",
    "bootstrap": "npm run cdk --workspace @retrieval-instructions/infra -- bootstrap",
    "deploy": "npm run deploy --workspace @retrieval-instructions/infra --",
    "destroy": "npm run destroy --workspace @retrieval-instructions/infra --",
    "format": "prettier --write \"**/*.{ts,mts,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,json,md,yml}\"",
    "verify": "npm run format:check && npm run lint && npm run build && npm test && npm run synth:example"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "tsx": "4.23.15"
  }
}
