{
  "name": "@retrieval-instructions/infra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT-0",
  "description": "CDK app for the retrieval instructions sample: the corpus bucket, managed knowledge bases, and optional tenant roles",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint \"{bin,lib,test}/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "synth:example": "cdk synth --quiet -c account=123456789012 -c trustedPrincipalArn=arn:aws:iam::123456789012:role/ExampleOperatorRole",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "aws-cdk": "2.1147.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.1.0"
  }
}
