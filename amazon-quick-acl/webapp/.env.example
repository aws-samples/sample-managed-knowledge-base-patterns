# Copy to .env and fill in. Read only by the harness (server/) and `npm run check:sharing`;
# none of this reaches the browser.

# AWS account and Region hosting your Amazon Quick instance. Must be the same Region as
# the managed knowledge base.
QUICK_AWS_ACCOUNT_ID=
QUICK_REGION=us-east-1

# ARNs of the two Amazon Quick users used to demonstrate ACL filtering. Find them with:
#
#   aws quicksight list-users --aws-account-id <account> --namespace default \
#     --region <region> --query "UserList[].{Name:UserName,Arn:Arn,Email:Email}"
#
# The email on each Quick user must match its entry in infra/seed-data/acl/global-acl.json.
# Bedrock ignores case and surrounding whitespace but does no alias resolution, so a
# `+` address is a different identity from the base address. Both users need the
# READER_PRO role; READER cannot open the embedded chat.
QUICK_USER_A_ARN=
QUICK_USER_B_ARN=

# Origin allowed to host the embedded iframe: a bare origin, no path or trailing slash.
# Must match where you open the app. Vite is pinned to port 5173 (strictPort), so this
# default works unless you change that port too. localhost and 127.0.0.1 are different
# origins.
QUICK_ALLOWED_DOMAIN=http://localhost:5173

# Optional: lock the embedded chat to a single Quick chat agent. Leave blank to let the
# user pick an agent in the embedded UI.
QUICK_FIXED_AGENT_ID=

# Optional: embed session lifetime in minutes (15-600). Defaults to 60.
QUICK_SESSION_LIFETIME_MINUTES=60

# Port for the local embed-URL harness. The Vite proxy in vite.config.ts targets 3001;
# change both together.
PORT=3001
