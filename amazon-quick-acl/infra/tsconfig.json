{
  "compilerOptions": {
    "target": "ES2023",
    // This package has no "type": "module", so nodenext resolves it as CommonJS, which
    // is what the CDK toolchain expects, without the deprecated node10 resolution.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // Type checking only. `cdk` runs the app through tsx, so nothing is emitted.
    "noEmit": true
  },
  "include": [
    "bin/**/*.ts",
    "lib/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "cdk.out"]
}
