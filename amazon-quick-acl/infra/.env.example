# Copy to .env and adjust.
#
# Target account and Region. Leave blank to use whatever your AWS profile resolves to.
#
# Note these are KB_TARGET_* and not CDK_DEFAULT_*. Setting CDK_DEFAULT_REGION here would
# have no effect: the CDK CLI replaces that variable in the app subprocess with the Region
# from your AWS configuration (defaulting to us-east-1 when none is set). These dedicated
# variables are read first so a value here always wins.
#
# The Region must be one of us-east-1, us-west-2, eu-west-1 or ap-southeast-2, and must
# match the Region of your Amazon Quick instance. `cdk synth` fails fast otherwise.
KB_TARGET_ACCOUNT=
KB_TARGET_REGION=us-east-1

# Name of the managed knowledge base.
KB_NAME=quick-managed-kb

# Set to "false" to create the S3 data source without document-level access control.
# Leaving this on is what makes the per-user filtering demo work.
KB_S3_ACL_ENABLED=true

# Two users for the ACL demo: the email addresses of your Amazon Quick users. Consumed by
# `npm run seed:render`.
#
# Bedrock compares these case-insensitively and ignores surrounding whitespace, but does
# no alias resolution: martha_rivera@example.com and martha_rivera+a@example.com are
# different identities.
# A wrong address raises no error at ingestion or at query time; that user just gets no
# results. Copy them from `aws quicksight list-users` rather than retyping them.
#
# Create the two Quick users before rendering so you know their exact addresses. They
# need the READER_PRO role (Quick Professional); plain READER is BI-only and cannot use
# chat agents or spaces:
#   aws quicksight register-user --aws-account-id <account> --namespace default \
#     --identity-type QUICKSIGHT --user-role READER_PRO \
#     --email martha_rivera@example.com --user-name martha_rivera --region <region>
DEMO_USER_A_EMAIL=martha_rivera@example.com
DEMO_USER_B_EMAIL=mateo_jackson@example.com
