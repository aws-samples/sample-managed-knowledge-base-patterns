ller" target="alarm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l-alarm" value="ExecutionsFailed metric" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#545B64;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="640" width="140" height="30" as="geometry" /></mxCell><mxCell id="e-sched" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;strokeColor=#8C4FFF;dashed=1;dashPattern=8 4;exitX=1;exitY=0.7142857142857143;exitDx=0;exitDy=0;entryX=0;entryY=0.7142857142857143;entryDx=0;entryDy=0;" edge="1" parent="1" source="sched" target="sweep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l-sched" value="invoke every 15 minutes" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="792" width="230" height="18" as="geometry" /></mxCell><mxCell id="b4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="818" width="30" height="30" as="geometry" /></mxCell><mxCell id="e-list" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;strokeColor=#8C4FFF;dashed=1;dashPattern=8 4;exitX=0;exitY=0.21428571428571427;exitDx=0;exitDy=0;entryX=1;entryY=0.7142857142857143;entryDx=0;entryDy=0;" edge="1" parent="1" source="sweep" target="kb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="740" /><mxPoint x="680" y="560" /></Array></mxGeometry></mxCell><mxCell id="l-list" value="&lt;b&gt;ListDataSources&lt;/b&gt;, &lt;b&gt;ListIngestionJobs&lt;/b&gt;&lt;br&gt;per tracked knowledge base" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="690" y="700" width="340" height="34" as="geometry" /></mxCell><mxCell id="e-sclaim" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;strokeColor=#8C4FFF;dashed=1;dashPattern=8 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sweep" target="claim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l-sclaim" value="claim missed jobs" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="950" y="640" width="170" height="30" as="geometry" /></mxCell><mxCell id="l-sexec" value="start the poller" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1180" y="640" width="105" height="30" as="geometry" /></mxCell><mxCell id="e-sexec" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;strokeColor=#8C4FFF;dashed=1;dashPattern=8 4;exitX=1;exitY=0.35714285714285715;exitDx=0;exitDy=0;entryX=0;entryY=0.7857142857142857;entryDx=0;entryDy=0;" edge="1" parent="1" source="sweep" target="poller"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="760" /><mxPoint x="1290" y="570" /></Array></mxGeometry></mxCell><mxCell id="e-sstarted" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;strokeColor=#8C4FFF;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sweep" target="eb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="905" /><mxPoint x="1745" y="905" /></Array></mxGeometry></mxCell><mxCell id="l-sstarted" value="PutEvents &lt;b&gt;Knowledge Base Ingestion Job Started&lt;/b&gt; (detectedBy RECONCILIATION)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#545B64;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1135" y="910" width="600" height="20" as="geometry" /></mxCell><mxCell id="e-cap" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;strokeColor=#545B64;dashed=1;dashPattern=2 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eb" target="cap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l-cap" value="capture rule&lt;br&gt;(captureEvents)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#545B64;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1830" y="495" width="140" height="32" as="geometry" /></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2240" y="120" width="560" height="850" as="geometry" /></mxCell><mxCell id="lb1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2260" y="154" width="30" height="30" as="geometry" /></mxCell><mxCell id="lt1" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;A subscription filter on the ingestion log group sends each INGESTION_JOB_STARTED record to the Start function." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2305" y="146" width="475" height="110" as="geometry" /></mxCell><mxCell id="lb2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2260" y="289" width="30" height="30" as="geometry" /></mxCell><mxCell id="lt2" value="&lt;b&gt;Claim&lt;/b&gt;&lt;br&gt;The Start function claims the job with a conditional write to the claim table, starts a poller execution named after the knowledge base, data source, and job IDs, and sends the Started event. Each job gets one Started event and one poller, whichever path sees it first." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2305" y="281" width="475" height="110" as="geometry" /></mxCell><mxCell id="lb3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2260" y="424" width="30" height="30" as="geometry" /></mxCell><mxCell id="lt3" value="&lt;b&gt;Finish&lt;/b&gt;&lt;br&gt;The poller calls GetIngestionJob every 60 s plus 0–10 s of jitter until the status is COMPLETE, FAILED, or STOPPED, then sends the Finished event with the status, statistics, and failure reasons." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2305" y="416" width="475" height="110" as="geometry" /></mxCell><mxCell id="lb4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2260" y="559" width="30" height="30" as="geometry" /></mxCell><mxCell id="lt4" value="&lt;b&gt;Sweep&lt;/b&gt;&lt;br&gt;Every 15 minutes, the Sweep function lists recent jobs for each tracked knowledge base and claims any job the log path missed, then starts its poller and sends its Started event." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2305" y="551" width="475" height="110" as="geometry" /></mxCell><mxCell id="lx0" value="&lt;b&gt;Alarm&lt;/b&gt;&lt;br&gt;A CloudWatch alarm on the poller's ExecutionsFailed metric. It has no actions." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2305" y="686" width="475" height="60" as="geometry" /></mxCell><mxCell id="lx1" value="&lt;b&gt;Event capture (optional)&lt;/b&gt;&lt;br&gt;An EventBridge rule writes every event with the pattern's source to a log group." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2305" y="761" width="475" height="60" as="geometry" /></mxCell><mxCell id="key" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="2260" y="855" width="520" height="130" as="geometry" /></mxCell><mxCell id="key-e0" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;strokeColor=#232F3E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="877" as="sourcePoint" /><mxPoint x="2350" y="877" as="targetPoint" /></mxGeometry></mxCell><mxCell id="key-t0" value="Start path (steps 1–2)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2365" y="867" width="380" height="20" as="geometry" /></mxCell><mxCell id="key-e1" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;strokeColor=#007CBD;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="905" as="sourcePoint" /><mxPoint x="2350" y="905" as="targetPoint" /></mxGeometry></mxCell><mxCell id="key-t1" value="Finish path (step 3)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2365" y="895" width="380" height="20" as="geometry" /></mxCell><mxCell id="key-e2" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;strokeColor=#8C4FFF;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="933" as="sourcePoint" /><mxPoint x="2350" y="933" as="targetPoint" /></mxGeometry></mxCell><mxCell id="key-t2" value="Sweep path, the fallback (step 4)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2365" y="923" width="380" height="20" as="geometry" /></mxCell><mxCell id="key-e3" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeWidth=1.5;strokeColor=#545B64;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="961" as="sourcePoint" /><mxPoint x="2350" y="961" as="targetPoint" /></mxGeometry></mxCell><mxCell id="key-t3" value="Sync, alarm metric, and event capture" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontFamily=Helvetica;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2365" y="951" width="380" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
