# Copy to .env.local for local development. Do not commit .env.local.
#
# Everything here is public by nature: a browser app cannot hold a secret, and the
# Cognito client ID appears in every authorization redirect. There is no client secret
# because this is a public OAuth client using Authorization Code with PKCE.

# Base URL of the backend API, with no trailing slash.
VITE_API_BASE_URL=http://localhost:3001

# Cognito hosted UI domain, without a scheme.
# Find it under App integration → Domain in the user pool console.
VITE_COGNITO_DOMAIN=your-prefix.auth.us-east-1.amazoncognito.com

# Cognito app client ID. Must be a public client with no secret, with the
# authorization code grant enabled and the openid, email, and profile scopes allowed.
VITE_COGNITO_CLIENT_ID=

# The callback and sign-out URLs are derived from the browser's own origin
# (<origin>/callback and <origin>/), so they need no configuration here — but both
# must be registered on the app client, or Cognito rejects the redirect.
