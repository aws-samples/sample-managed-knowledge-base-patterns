# Copy to .env and fill in, or export these in your shell. Do not commit .env.
#
# The service refuses to start if any required value is missing, rather than
# coming up and rejecting every request. Nothing here is a secret: these are
# public identifiers and origins. There is no client secret because the frontend
# is a public OAuth client and the backend verifies tokens rather than exchanging
# them.

# --- Required: identity ---------------------------------------------------
#
# Amazon Cognito user pool, e.g. us-east-1_ABC123DEF. The token issuer and JWKS
# URLs are derived from this, so they cannot drift out of agreement.
COGNITO_USER_POOL_ID=

# Cognito app client ID. Verified against each token's `aud` claim, so a token
# issued for a different app client is rejected.
COGNITO_CLIENT_ID=

# Defaults to AWS_REGION when unset. Set only if the pool lives in a different
# region from the rest of the deployment.
# COGNITO_REGION=us-east-1

# --- Required in a browser deployment: CORS -------------------------------
#
# Comma-separated list of exact origins permitted to call this API. No wildcard
# is accepted. An empty value logs a warning at startup and permits no browser
# origin at all.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Required: retrieval --------------------------------------------------
#
# The knowledge base to query, e.g. ABCD1234EF. `make sample-env` writes this
# value from the deployed stack.
KNOWLEDGE_BASE_ID=

# --- Optional -------------------------------------------------------------
PORT=3001
AWS_REGION=us-east-1

# An AgentCore Memory resource ID, for multi-turn chat. Unset means chat is
# single-turn, and `GET /knowledgebase/capabilities` reports
# `conversationMemory: false` so a client can say so rather than appear to forget.
# MEMORY_ID=
