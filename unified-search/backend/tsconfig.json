{
  "compilerOptions": {
    // NestJS 12 is published as pure ESM — every @nestjs/* package declares
    // "type": "module" with no CommonJS build. So this project is ESM too, and
    // the test runner is vitest rather than jest, which cannot `require` an ESM
    // dependency under a CommonJS transform.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",

    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],

    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
